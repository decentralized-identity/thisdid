{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "thisdid-driver-julia",
  "main": "index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // No secrets required: did:julia resolves by reading public Chia state, and
  // the DID's own identifier fixes the singleton lineage. Optional override:
  // JULIA_RPC_URL — any Chia full node RPC base (default https://api.coinset.org).
  // Verification does not depend on which node answers: state is served only
  // after its recomputed singleton puzzle hash matches the on-chain coin.
}

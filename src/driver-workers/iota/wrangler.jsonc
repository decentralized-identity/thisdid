{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "thisdid-driver-iota",
  "main": "index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // No secrets required: resolution reads public IOTA Rebased fullnodes.
  // Optional overrides: IOTA_RPC_MAINNET_URL / IOTA_RPC_TESTNET_URL /
  // IOTA_RPC_DEVNET_URL (network aliases iota / testnet / devnet).
}

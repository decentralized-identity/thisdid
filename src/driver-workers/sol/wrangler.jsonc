{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "thisdid-driver-sol",
  "main": "index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Cluster RPC URLs are SECRETS (they carry provider API keys — e.g. Alchemy):
  //   wrangler secret put SOL_RPC_MAINNET_URL --config src/driver-workers/sol/wrangler.jsonc
  //   wrangler secret put SOL_RPC_DEVNET_URL  --config src/driver-workers/sol/wrangler.jsonc
  // Locally: copy .dev.vars.example to .dev.vars. Unconfigured clusters fail closed.
}

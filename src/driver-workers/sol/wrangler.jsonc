{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "thisdid-driver-sol",
  "main": "index.ts",
  // Vendored packages are not npm dependencies (npm rewrites anything it
  // finds in node_modules); wrangler resolves them by alias, tsc by "paths",
  // vitest by resolve.alias.
  "alias": {
    "did-resolver": "../../../vendor/did-resolver/lib/resolver.mjs",
    "@thisdid/sol-did-resolver": "../../../vendor/sol-did-resolver/lib/index.js"
  },
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Alchemy cluster base URLs are public; the token is the ALCHEMY_API_KEY
  // secret, appended after the trailing `/` at request-construction time:
  //   wrangler secret put ALCHEMY_API_KEY --config src/driver-workers/sol/wrangler.jsonc
  // Locally: copy .dev.vars.example to .dev.vars. Unconfigured clusters fail closed.
  "vars": {
    "SOL_RPC_MAINNET_BASE_URL": "https://solana-mainnet.g.alchemy.com/v2/",
    "SOL_RPC_DEVNET_BASE_URL": "https://solana-devnet.g.alchemy.com/v2/",
  },
}

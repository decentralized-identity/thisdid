# Alchemy token only — the cluster base URLs live as public vars in
# wrangler.jsonc and the code appends this key after their trailing `/`.
# Copy to .dev.vars for local `wrangler dev`; set as a Worker secret for deploys.
ALCHEMY_API_KEY=replace-me
# Optional non-Alchemy override for the testnet cluster (full URL, legacy form):
# SOL_RPC_TESTNET_URL="https://api.testnet.solana.com"

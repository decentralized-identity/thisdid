# Solana JSON-RPC endpoints per cluster (full URLs, e.g. Alchemy).
# Copy to .dev.vars for local `wrangler dev`; set as Worker secrets for deploys.
SOL_RPC_MAINNET_URL="https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY"
SOL_RPC_DEVNET_URL="https://solana-devnet.g.alchemy.com/v2/YOUR_KEY"
# SOL_RPC_TESTNET_URL="https://api.testnet.solana.com"

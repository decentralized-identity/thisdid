{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "thisdid-driver-hedera",
  "main": "index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // No secrets required: resolution reads Hedera's public mirror nodes.
  // Optional overrides: HEDERA_MIRROR_MAINNET_URL / HEDERA_MIRROR_TESTNET_URL.
}

{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "thisdid-driver-ebsi",
  "main": "index.ts",
  // Vendored packages are not npm dependencies (npm rewrites anything it
  // finds in node_modules); wrangler resolves them by alias, tsc by "paths",
  // vitest by resolve.alias.
  "alias": {
    "did-resolver": "../../../vendor/did-resolver/lib/resolver.mjs"
  },
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // EBSI DID registry (pilot environment). Legal-entity DIDs resolve here.
    "EBSI_DID_REGISTRY": "https://api-pilot.ebsi.eu/did-registry/v5/identifiers",
  },
}

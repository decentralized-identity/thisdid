{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "thisdid-driver-cid",
  "main": "index.ts",
  // Vendored packages are not npm dependencies (npm rewrites anything it
  // finds in node_modules); wrangler resolves them by alias, tsc by "paths",
  // vitest by resolve.alias.
  "alias": {
    "did-resolver": "../../../vendor/did-resolver/lib/resolver.mjs",
    "@thisdid/cid-did-resolver": "../../../vendor/cid-did-resolver/lib/index.js"
  },
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Archon Gatekeeper API base — event chains are fetched from
    // {base}/dids/export and fully verified inside this Worker.
    "CID_GATEKEEPER_URL": "https://archon.technology/api/v1",
  },
}

{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "thisdid-driver-empe",
  "main": "index.ts",
  // Vendored packages are not npm dependencies (npm rewrites anything it
  // finds in node_modules); wrangler resolves them by alias, tsc by "paths",
  // vitest by resolve.alias.
  "alias": {
    "did-resolver": "../../../vendor/did-resolver/lib/resolver.mjs",
    "@thisdid/empe-did-resolver": "../../../vendor/empe-did-resolver/lib/index.js"
  },
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // No secrets required: resolution reads public Empeiria Tendermint RPC.
  // Empeiria has no public mainnet yet (verified 24 Aug 2026) — set
  // EMPE_RPC_MAINNET_URL the day it launches; EMPE_RPC_TESTNET_URL
  // overrides the rpc-testnet.empe.io default.
}

{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "thisdid-driver-near",
  "main": "index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Public NEAR JSON-RPC endpoints (no credentials). A keyed provider URL
    // should instead be set as a secret and these vars removed.
    "NEAR_RPC_MAINNET_URL": "https://rpc.mainnet.near.org",
    "NEAR_RPC_TESTNET_URL": "https://rpc.testnet.near.org",
    // NEAR_REGISTRY_CONTRACT_MAINNET / NEAR_REGISTRY_CONTRACT_TESTNET are
    // unset until a DID registry contract is chosen; base58 registry
    // identifiers return notConfigured meanwhile.
  },
}

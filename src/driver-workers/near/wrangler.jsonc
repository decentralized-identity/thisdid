{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "thisdid-driver-near",
  "main": "index.ts",
  // Vendored packages are not npm dependencies (npm rewrites anything it
  // finds in node_modules); wrangler resolves them by alias, tsc by "paths",
  // vitest by resolve.alias.
  "alias": {
    "did-resolver": "../../../vendor/did-resolver/lib/resolver.mjs",
    "@thisdid/near-did-resolver": "../../../vendor/near-did-resolver/lib/index.js"
  },
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // FastNear's free public JSON-RPC (the official successor to the
    // deprecated rpc.*.near.org endpoints, which now aggressively throttle
    // shared egress IPs — canary failures, 23 Aug 2026). A keyed provider URL
    // should instead be set as a secret and these vars removed.
    "NEAR_RPC_MAINNET_URL": "https://free.rpc.fastnear.com",
    "NEAR_RPC_TESTNET_URL": "https://test.rpc.fastnear.com",
    // NEAR_REGISTRY_CONTRACT_MAINNET / NEAR_REGISTRY_CONTRACT_TESTNET are
    // unset until a DID registry contract is chosen; base58 registry
    // identifiers return notConfigured meanwhile.
  },
}

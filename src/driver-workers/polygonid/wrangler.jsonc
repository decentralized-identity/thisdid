{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "thisdid-driver-polygonid",
  "main": "index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Network RPC URLs are SECRETS (they carry provider API keys — e.g. Alchemy):
  //   wrangler secret put POLYGONID_RPC_POLYGON_MAIN_URL --config src/driver-workers/polygonid/wrangler.jsonc
  //   wrangler secret put POLYGONID_RPC_POLYGON_AMOY_URL --config src/driver-workers/polygonid/wrangler.jsonc
  // Locally: copy .dev.vars.example to .dev.vars. Unconfigured networks fail closed.
}

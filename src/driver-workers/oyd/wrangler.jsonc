{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "thisdid-driver-oyd",
  "main": "index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // No secrets: OYDID repositories are open HTTPS endpoints and the DID
  // itself names custom repos via its %40host suffix.
}

{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "thisdid-driver-xrpl",
  "main": "index.ts",
  // Vendored packages are not npm dependencies (npm rewrites anything it
  // finds in node_modules); wrangler resolves them by alias, tsc by "paths",
  // vitest by resolve.alias.
  "alias": {
    "did-resolver": "../../../vendor/did-resolver/lib/resolver.mjs",
    "@thisdid/xrpl-did-resolver": "../../../vendor/xrpl-did-resolver/lib/index.js"
  },
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // No secrets required: resolution reads public XRPL JSON-RPC endpoints.
  // Optional overrides: XRPL_RPC_MAINNET_URL / XRPL_RPC_TESTNET_URL /
  // XRPL_RPC_DEVNET_URL (network-ids 0 / 1 / 2).
}

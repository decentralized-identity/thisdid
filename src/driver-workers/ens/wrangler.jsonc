{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "thisdid-driver-ens",
  "main": "index.ts",
  // Vendored packages are not npm dependencies (npm rewrites anything it
  // finds in node_modules); wrangler resolves them by alias, tsc by "paths",
  // vitest by resolve.alias.
  "alias": {
    "did-resolver": "../../../vendor/did-resolver/lib/resolver.mjs",
    "@thisdid/ens-did-resolver": "../../../vendor/ens-did-resolver/lib/index.js"
  },
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Alchemy base URL is public; the token is the ALCHEMY_API_KEY secret,
  // appended after the trailing `/` at request-construction time:
  //   wrangler secret put ALCHEMY_API_KEY --config src/driver-workers/ens/wrangler.jsonc
  // Locally: copy .dev.vars.example to .dev.vars. Fails closed until configured.
  "vars": {
    "ETH_RPC_MAINNET_BASE_URL": "https://eth-mainnet.g.alchemy.com/v2/",
  },
}

{
  "name": "@thisdid/web-did-resolver",
  "version": "1.0.0",
  "description": "DIF did-resolver driver for did:web — the DIF web-did-resolver core, custodied in the ThisDID fork, with a standalone command-line resolver.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./node": {
      "types": "./lib/node-guard.d.ts",
      "default": "./lib/node-guard.js"
    }
  },
  "bin": {
    "thisdid-resolve-web": "./lib/bin.js"
  },
  "files": [
    "lib",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "test": "vitest run",
    "test:live": "WEB_LIVE=1 vitest run",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "web-did-resolver": "link:../forks/web-did-resolver",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "did-resolver": "^4.1.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "did-resolver": ">=4.1.0"
  }
}

{
  "name": "thisdid",
  "version": "2.0.0",
  "private": true,
  "description": "ThisDID.com — DIF Universal W3C DID Resolver.",
  "type": "module",
  "workspaces": [
    "vendor/did-resolver",
    "web"
  ],
  "scripts": {
    "build:vendor": "npm run build -w did-resolver",
    "build:web": "npm run build -w @thisdid/web",
    "build": "npm run build:vendor && npm run build:web",
    "dev": "npm run build:web && concurrently -k -n worker,web -c blue,magenta \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:worker": "wrangler dev",
    "dev:web": "npm run dev -w @thisdid/web",
    "deploy": "npm run build && wrangler deploy",
    "dev:probe": "wrangler dev --config probe/wrangler.jsonc --test-scheduled",
    "deploy:probe": "wrangler deploy --config probe/wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/swagger-ui": "0.6.1",
    "did-resolver": "*",
    "hono": "4.13.1",
    "web-did-resolver": "2.0.32"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260812.1",
    "concurrently": "10.0.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.121.0"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thisdid-resolver",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The built landing SPA is served through the Worker so the root path can
  // content-negotiate (HTML for browsers, JSON for `Accept: application/*json`).
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker for every request so `/` can content-negotiate (SPA vs JSON)
    // and DID deep-links can resolve. Static assets are forwarded via env.ASSETS.
    "run_worker_first": true
  },
  "vars": {
    // Redundant upstream Universal Resolver bases (DID appended as `/{did}`), used as
    // fallback routes when thisDID cannot resolve a method itself. See src/resolvers/registry.ts
    // for the per-method ordering of these routes.
    "GODIDDY_RESOLVER": "https://api.godiddy.com/1.0.0/universal-resolver/identifiers",
    "ARCHON_RESOLVER": "https://resolver.archon.technology/1.0/identifiers",
    // GoPlausible Universal Resolver (DID appended as `/{did}`) — tried first for did:algo / did:nfd.
    "GOPLAUSIBLE_RESOLVER": "https://goplausible.xyz/api/1.0/identifiers",
    "RESOLVER_LABEL": "thisdid-edge"
  },
  // Analytics: D1 = authoritative per-resolution event log; KV = live counter + dashboard cache.
  // Create them and paste the ids below:
  //   wrangler d1 create thisdid-analytics
  //   wrangler kv namespace create STATS_KV
  // wrangler d1 migrations apply thisdid-analytics --remote

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thisdid-analytics",
      "database_id": "509d9b5e-5fd1-4271-bb2b-5dfe73715770",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STATS_KV",
      "id": "9fdb1c1e68ed4f0d87bfea42438b8917"
    }
  ],
  "ratelimits": [
    {
      "name": "RESOLUTION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 60 }
    }
  ]
}
